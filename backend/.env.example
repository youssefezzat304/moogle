# Paths may be absolute or relative to the repository root.
MOOGLE_CATALOG_PATH=storage/catalogs/lunar-v1
MOOGLE_INDEX_PATH=storage/indexes/bpe_geo/v1
MOOGLE_MODEL_MANIFEST_PATH=storage/models/bpe_geo/manifest.yaml

# The deployable MVP uses CPU-only PyTorch.
MOOGLE_MODEL_DEVICE=cpu

# Use 0.0.0.0 when the hosting platform must expose the API externally.
MOOGLE_HOST=127.0.0.1
PORT=8000
