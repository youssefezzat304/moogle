[Unit]
Description=Moogle retrieval backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=moogle
Group=moogle
WorkingDirectory=/opt/moogle
EnvironmentFile=/etc/moogle/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/moogle/.venv/bin/python backend/main.py

Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
